# Solo servidor (Vercel → Settings → Environment Variables + este archivo local).
# Nunca uses el prefijo VITE_ aquí. Tras cambiar vars en Vercel, haz Redeploy.
#
# DATABASE_URL: connection string del MISMO proyecto/rama de Neon que miras en la consola.
# JWT_SECRET: obligatorio en Vercel (mínimo 16 caracteres). En local, si falta, hay fallback de desarrollo.
DATABASE_URL=
JWT_SECRET=
